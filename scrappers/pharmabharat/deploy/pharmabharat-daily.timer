[Unit]
Description=Run the PharmaBharat daily scraper each morning
Documentation=file:/opt/job-scrappers/scrappers/pharmabharat/readme.md

[Timer]
# 08:00 India time. OnCalendar respects the unit's timezone, and the scraper
# pins its own scrape window to IST regardless, so a UTC host is fine.
OnCalendar=*-*-* 08:00:00 Asia/Kolkata

# If the instance was stopped/asleep at 08:00, run once it is back.
Persistent=true

# Stagger slightly so a fleet does not hit the site at the same second.
RandomizedDelaySec=300

Unit=pharmabharat-daily.service

[Install]
WantedBy=timers.target
